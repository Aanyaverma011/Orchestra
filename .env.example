# Optional. Copy to .env next to docker-compose.yml. Compose reads it automatically.
# Everything has a working default, so you can run without this file.

# Signing key for login tokens. Use a long random value anywhere public.
JWT_SECRET=change-me-to-a-long-random-string

# Job submissions allowed per user per minute (the load test needs a high value)
RATE_LIMIT_PER_MIN=20

# Pause inside every job so status changes are visible in a demo. Use 0-200 for load tests.
SIMULATE_WORK_MS=1500

# json = render emails locally. ethereal = send to a fake inbox and get a preview link (needs internet).
MAIL_MODE=json

# Optional: plain-English failure summaries written by a Groq model.
# Without a key Orchestra uses its built-in rules, so the feature still works.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Set to false to skip the demo history on first start
SEED_DEMO_DATA=false
